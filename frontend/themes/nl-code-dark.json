{
  "$schema": "vscode://schemas/color-theme",
  "name": "NL Code Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#7531FE",
    "foreground": "#E6E1F2",
    "descriptionForeground": "#A9A2BD",
    "errorForeground": "#FF6B81",
    "icon.foreground": "#C9BEE6",
    "sash.hoverBorder": "#7531FE",
    "widget.border": "#3A2D55",
    "widget.shadow": "#0D0A14AA",
    "selection.background": "#7531FE66",
    "input.background": "#171224",
    "input.border": "#3C3157",
    "input.foreground": "#F1EDFA",
    "input.placeholderForeground": "#8D84A6",
    "inputOption.activeBorder": "#E4469B",
    "inputValidation.errorBorder": "#FF6B81",
    "dropdown.background": "#1B152B",
    "dropdown.border": "#3C3157",
    "dropdown.foreground": "#F1EDFA",
    "button.background": "#7531FE",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#8A4BFF",
    "button.secondaryBackground": "#2C2142",
    "button.secondaryForeground": "#EDE7FF",
    "button.secondaryHoverBackground": "#3A2B58",
    "badge.background": "#E4469B",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#E4469B",
    "list.activeSelectionBackground": "#7531FE4D",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#7531FE2B",
    "list.hoverBackground": "#FFFFFF0D",
    "list.focusOutline": "#7531FE",
    "list.highlightForeground": "#F07AB8",
    "tree.indentGuidesStroke": "#3A2D55",
    "activityBar.background": "#100C1B",
    "activityBar.foreground": "#E9E3F8",
    "activityBar.inactiveForeground": "#8E86A4",
    "activityBar.activeBorder": "#E4469B",
    "activityBar.activeBackground": "#7531FE22",
    "activityBarBadge.background": "#E4469B",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#141020",
    "sideBar.foreground": "#DCD5EC",
    "sideBar.border": "#2A213D",
    "sideBarTitle.foreground": "#F1EDFA",
    "sideBarSectionHeader.background": "#1B152B",
    "sideBarSectionHeader.foreground": "#E9E3F8",
    "sideBarSectionHeader.border": "#2A213D",
    "editorGroup.border": "#2A213D",
    "editorGroupHeader.tabsBackground": "#100C1B",
    "editorGroupHeader.noTabsBackground": "#100C1B",
    "tab.activeBackground": "#171224",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#E4469B",
    "tab.inactiveBackground": "#100C1B",
    "tab.inactiveForeground": "#9B93B0",
    "tab.border": "#2A213D",
    "editor.background": "#100C1B",
    "editor.foreground": "#E6E1F2",
    "editorLineNumber.foreground": "#5E5575",
    "editorLineNumber.activeForeground": "#C9BEE6",
    "editorCursor.foreground": "#E4469B",
    "editor.selectionBackground": "#7531FE55",
    "editor.inactiveSelectionBackground": "#7531FE2B",
    "editor.lineHighlightBackground": "#FFFFFF08",
    "editor.findMatchBackground": "#E4469B66",
    "editor.findMatchHighlightBackground": "#E4469B33",
    "editorWidget.background": "#1B152B",
    "editorWidget.border": "#3C3157",
    "editorSuggestWidget.background": "#1B152B",
    "editorSuggestWidget.border": "#3C3157",
    "editorSuggestWidget.selectedBackground": "#7531FE4D",
    "editorHoverWidget.background": "#1B152B",
    "editorHoverWidget.border": "#3C3157",
    "peekView.border": "#7531FE",
    "peekViewEditor.background": "#141020",
    "peekViewResult.background": "#141020",
    "panel.background": "#100C1B",
    "panel.border": "#2A213D",
    "panelTitle.activeForeground": "#F1EDFA",
    "panelTitle.activeBorder": "#E4469B",
    "statusBar.background": "#521B8D",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#2C2142",
    "statusBar.debuggingBackground": "#BA266C",
    "statusBarItem.remoteBackground": "#7531FE",
    "titleBar.activeBackground": "#100C1B",
    "titleBar.activeForeground": "#E9E3F8",
    "titleBar.inactiveBackground": "#100C1B",
    "titleBar.inactiveForeground": "#8E86A4",
    "titleBar.border": "#2A213D",
    "menu.background": "#1B152B",
    "menu.foreground": "#E9E3F8",
    "menu.selectionBackground": "#7531FE4D",
    "menu.border": "#3C3157",
    "notificationCenterHeader.background": "#1B152B",
    "notifications.background": "#1B152B",
    "notifications.border": "#3C3157",
    "quickInput.background": "#171224",
    "quickInput.foreground": "#F1EDFA",
    "quickInputList.focusBackground": "#7531FE4D",
    "terminal.background": "#100C1B",
    "terminal.foreground": "#E6E1F2",
    "terminal.ansiBrightMagenta": "#E4469B",
    "terminal.ansiBrightCyan": "#46A3C0",
    "terminal.ansiBrightViolet": "#AB83C6",
    "gitDecoration.modifiedResourceForeground": "#E4B65B",
    "gitDecoration.untrackedResourceForeground": "#55C58A",
    "gitDecoration.deletedResourceForeground": "#FF6B81",
    "diffEditor.insertedTextBackground": "#55C58A22",
    "diffEditor.removedTextBackground": "#FF6B8122",
    "editorError.foreground": "#FF6B81",
    "editorWarning.foreground": "#E4B65B",
    "editorInfo.foreground": "#46A3C0",
    "editorGutter.addedBackground": "#55C58A",
    "editorGutter.modifiedBackground": "#E4469B",
    "editorGutter.deletedBackground": "#FF6B81",
    "extensionButton.prominentBackground": "#7531FE",
    "extensionButton.prominentHoverBackground": "#8A4BFF"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7E7494", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#C9A6FF" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#F07AB8" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#8FD3E8" }
    },
    {
      "scope": ["entity.name.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#AB83C6" }
    },
    {
      "scope": ["variable", "variable.other", "entity.name.variable"],
      "settings": { "foreground": "#E6E1F2" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character.escape"],
      "settings": { "foreground": "#E4B65B" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF6B81" }
    }
  ]
}
