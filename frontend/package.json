{
  "name": "nl-coding-agent",
  "displayName": "NL Coder",
  "description": "NL Coder — NL Chat and mission control for the local NL Coding Engine: provider/model selection, project-scoped attachments, editor context, authorized URL research, persisted history, persistent missions, diffs, candidate/oracle verification and reviewer verdicts. The Python engine remains the single source of truth.",
  "version": "0.7.0",
  "publisher": "nlcodingagent",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:nlCodingAgent.chat",
    "onCommand:nlCodingAgent.startChat",
    "onCommand:nlCodingAgent.openHome",
    "onCommand:nlCodingAgent.startMission",
    "onCommand:nlCodingAgent.showMissions",
    "onCommand:nlCodingAgent.showEngineSettings",
    "onCommand:nlCodingAgent.openModelHub",
    "onCommand:nlCodingAgent.openAgents",
    "onCommand:nlCodingAgent.openStorage",
    "onCommand:nlCodingAgent.toggleMissionExecution",
    "onCommand:nlCodingAgent.showStatus",
    "onCommand:nlCodingAgent.reconnect",
    "onCommand:nlCodingAgent.steerChat",
    "onCommand:nlCodingAgent.stopChat",
    "onCommand:nlCodingAgent.askAboutFile",
    "onCommand:nlCodingAgent.restoreTheme"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test:integration": "node test/integration.cjs",
    "test:webview": "node test/webview.cjs",
    "test:extension": "node test/runExtensionTests.cjs",
    "test:mission": "node test/runMissionTests.cjs",
    "test:team-mission": "node test/runTeamMissionTests.cjs",
    "test:installed-team-mission": "node test/runInstalledTeamMissionTests.cjs",
    "test:resume": "node test/runResumeTests.cjs",
    "test:vsix": "node test/runInstalledVsixTests.cjs",
    "test:chat-features": "node test/runChatFeatureTests.cjs",
    "test:installed-chat": "node test/runInstalledChatFeatureTests.cjs",
    "package:vsix": "vsce package --out ../.workspace/dist/NL-Coding-Agent-0.7.0.vsix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "^5.5.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "nlCodingAgent.openHome",
        "title": "NL Code: Open Home",
        "icon": "$(home)"
      },
      {
        "command": "nlCodingAgent.startChat",
        "title": "NL Code: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "nlCodingAgent.startMission",
        "title": "NL Code: New Mission…",
        "icon": "$(rocket)"
      },
      {
        "command": "nlCodingAgent.showMissions",
        "title": "NL Code: Open Mission Control",
        "icon": "$(checklist)"
      },
      {
        "command": "nlCodingAgent.showEngineSettings",
        "title": "NL Code: Open Engine Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nlCodingAgent.openModelHub",
        "title": "NL Code: Open Model Hub",
        "icon": "$(server)"
      },
      {
        "command": "nlCodingAgent.openAgents",
        "title": "NL Code: Open Agents",
        "icon": "$(organization)"
      },
      {
        "command": "nlCodingAgent.openStorage",
        "title": "NL Code: Open Storage Manager",
        "icon": "$(database)"
      },
      {
        "command": "nlCodingAgent.selectMission",
        "title": "NL Code: Select Mission",
        "icon": "$(arrow-right)"
      },
      {
        "command": "nlCodingAgent.askAboutFile",
        "title": "NL Code: Ask about this file",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "nlCodingAgent.askAboutPath",
        "title": "NL Code: Ask about this path",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "nlCodingAgent.reviewChanges",
        "title": "NL Code: Review changes",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "nlCodingAgent.toggleMissionExecution",
        "title": "NL Code: Toggle Mission Execution"
      },
      {
        "command": "nlCodingAgent.restoreTheme",
        "title": "NL Code: Restore VS Code Theme"
      },
      {
        "command": "nlCodingAgent.showStatus",
        "title": "NL Code: Show Backend Status"
      },
      {
        "command": "nlCodingAgent.reconnect",
        "title": "NL Code: Reconnect Backend"
      },
      {
        "command": "nlCodingAgent.steerChat",
        "title": "NL Code: Steer Running Chat…"
      },
      {
        "command": "nlCodingAgent.stopChat",
        "title": "NL Code: Stop Running Chat"
      }
    ],
    "configuration": {
      "title": "NL Coder",
      "properties": {
        "nlCodingAgent.engineRoot": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Absolute path to the NL Coding Engine installation: the folder that contains `nl_agent.py` and `python\\python.exe`. Leave empty to resolve it relative to this extension (the normal in-repository or bundled layout)."
        },
        "nlCodingAgent.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional absolute path to python.exe. Defaults to <engineRoot>\\python\\python.exe."
        },
        "nlCodingAgent.requestTimeoutSeconds": {
          "type": "number",
          "default": 1800,
          "minimum": 30,
          "maximum": 7200,
          "description": "Timeout for one chat turn. Local models may need minutes to load and reason; long runs are expected."
        },
        "nlCodingAgent.allowExecution": {
          "type": "boolean",
          "default": false,
          "scope": "machine-overridable",
          "markdownDescription": "Start the NL Coding Engine with `--allow-execution`, which permits mission start/cancel from this extension. Missions still require an explicit per-start confirmation and the engine's existing READ/WRITE/EXECUTE permissions. Leave disabled for a read-only assistant."
        },
        "nlCodingAgent.researchProfile": {
          "type": "string",
          "enum": [
            "manual",
            "trusted-auto-review"
          ],
          "default": "manual",
          "scope": "machine-overridable",
          "markdownDescription": "Research auto-review profile passed to the engine (`--research-profile`). `manual` reports needs_approval for external fetches; `trusted-auto-review` can auto-approve a granted web-fetch. Both still require the backend NETWORK and web-fetch grants; the extension never grants permissions."
        },
        "nlCodingAgent.showHomeOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Open the NL Code home dashboard when the standalone NL Code window starts."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "nlCodingAgentChat",
          "title": "NL Chat",
          "icon": "assets/icon.png"
        }
      ]
    },
    "views": {
      "nlCodingAgentChat": [
        {
          "id": "nlCodingAgent.chat",
          "name": "NL Chat",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [],
    "menus": {
      "editor/title": [
        {
          "command": "nlCodingAgent.askAboutFile",
          "when": "resourceScheme == file",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "nlCodingAgent.askAboutPath",
          "when": "resourceScheme == file",
          "group": "navigation@10"
        }
      ],
      "scm/title": [
        {
          "command": "nlCodingAgent.reviewChanges",
          "when": "scmProvider == git",
          "group": "navigation@10"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nlCodingAgent.openHome",
        "key": "ctrl+alt+h"
      },
      {
        "command": "nlCodingAgent.startMission",
        "key": "ctrl+alt+n"
      },
      {
        "command": "nlCodingAgent.startChat",
        "key": "ctrl+alt+c"
      }
    ],
    "themes": [
      {
        "label": "NL Code Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/nl-code-dark.json"
      }
    ]
  }
}
