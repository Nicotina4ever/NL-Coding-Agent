# Embedded runtime and vendor checkouts (protected; never committed or shipped as source).
# crewAI/ is staged for review at da_eliminare/crewAI (ROOT REORG Phase C, task-46);
# the root pattern is retained defensively for a restore or an accidental re-checkout.
python/
crewAI/
crewAI-tools/

# User data and diagnostics (never committed or shipped). data/ is the live SQLite
# database, self-build state and backups; it stays outside .workspace/ by design.
data/

# Generated workspace root (ROOT REORG Phase B, task-45): transient build/audit
# evidence, release payloads, run logs, telemetry/scratch caches and the legacy
# bootstrap CLI state all live under .workspace/<child>. Never committed, never
# shipped in the portable payload or the source-release builder.
.workspace/

# Legacy root locations retained defensively for a pre-reorg checkout or restore.
# The application no longer creates anything here (policy: nl_coding_agent/core/workspace.py).
logs/
state/
dist/
build/
cache/
temp/

# Python bytecode and packaging metadata
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/

# Test/type-check/coverage artifacts (regenerated on demand)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local scratch and accidental variable-expansion paths
tmp/
*.tmp
*.bak
nul
%SystemDrive%/

# Editor and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# Review-only staging for no-longer-needed material (task-44).
# Nothing here is shipped, packaged or deleted without explicit user authorization.
da_eliminare/*
!da_eliminare/README.md

# Local secrets / machine-local state
.env
*.sqlite3
*.db
